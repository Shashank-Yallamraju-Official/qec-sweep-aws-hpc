{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv add *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(uv run *)", "Bash(uv sync*)", "Bash(uv lock*)", "Bash(uv add *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)", "Bash(git commit *)", "Bash(git switch *)", "Bash(git push *)",
      "Bash(gh pr *)", "Bash(terraform fmt*)", "Bash(terraform validate*)", "Bash(terraform plan*)",
      "Bash(aws login*)", "Bash(aws sts get-caller-identity*)",
      "Bash(aws s3 ls*)", "Bash(aws s3 cp*)", "Bash(aws s3 sync*)",
      "Bash(aws ssm get-command-invocation*)", "Bash(aws ssm list-commands*)",
      "Bash(aws service-quotas get-*)", "Bash(aws service-quotas list-*)",
      "Bash(aws cloudformation describe-*)", "Bash(aws cloudformation list-*)", "Bash(aws ec2 describe-*)", "Bash(aws pricing *)",
      "Bash(pcluster describe-*)", "Bash(pcluster list-*)", "Bash(pcluster version*)"
    ],
    "ask": [
      "Bash(terraform apply*)", "Bash(terraform destroy*)",
      "Bash(pcluster create-*)", "Bash(pcluster delete-*)", "Bash(pcluster update-*)", "Bash(pcluster build-image*)",
      "Bash(aws ssm send-command*)", "Bash(aws s3 rm*)", "Bash(aws s3 rb*)", "Bash(aws s3api delete-*)", "Bash(aws s3api put-*)",
      "Bash(aws ec2 terminate-*)", "Bash(aws ec2 run-instances*)", "Bash(aws cloudformation delete-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-commit.sh before"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-file.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-commit.sh after"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mkdir -p .claude/metrics && jq -nc --arg b \"$(git branch --show-current)\" '{ts: (now | todate), event: \"session\", branch: $b}' >> .claude/metrics/events.jsonl"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-commit.sh after"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cd \"$(jq -r '.workspace.project_dir // .cwd')\" && uv run python tools/process_report.py --status",
    "refreshInterval": 30
  }
}
