{
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "allow": [
      "Bash(uv run *)", "Bash(uv sync*)", "Bash(uv lock*)", "Bash(uv add *)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)",
      "Bash(git commit *)", "Bash(git switch *)", "Bash(git push *)", "Bash(gh pr *)",
      "Bash(terraform fmt*)", "Bash(terraform validate*)", "Bash(terraform plan*)"
    ],
    "ask": [
      "Bash(terraform apply*)", "Bash(terraform destroy*)", "Bash(pcluster *)", "Bash(aws *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/guard-git.sh", "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/check-file.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
