Bootstrap: docker
From: python@sha256:8523d6abeb48ceae0b7240d30c5808fc26cb79c1a635bacdf19cf3baecfbec07

# python:3.12.16-slim by digest, the packages pinned on the hand-built node,
# and the project as a wheel built outside the image, so no build backend
# and nothing unpinned ever enters it. Two builds of one commit are the same.

%files
    image/packages.txt /opt/sweep/packages.txt
    dist/*.whl /opt/sweep/

%post
    pip install --no-cache-dir --quiet --no-deps -r /opt/sweep/packages.txt
    pip install --no-cache-dir --quiet --no-deps /opt/sweep/*.whl

%environment
    # The host's user site-packages and PYTHONPATH must not shadow the pinned ones.
    export PYTHONNOUSERSITE=1
    unset PYTHONPATH
    # PyMatching imports matplotlib, which wants a writable config dir the
    # container's home bind does not offer.
    export MPLCONFIGDIR=/tmp/matplotlib

%runscript
    exec sweep "$@"

%labels
    org.opencontainers.image.source https://github.com/Shashank-Yallamraju-Official/qec-sweep-aws-hpc
