Bootstrap: docker
From: python:3.12.16-slim

# The same Python and the same pinned packages as the hand-built node, with
# the project installed on top, so a fresh machine reproduces a cell bit for bit.

%files
    image/packages.txt /opt/sweep/packages.txt
    pyproject.toml /opt/sweep/pyproject.toml
    sweep /opt/sweep/sweep

%post
    pip install --no-cache-dir --quiet hatchling==1.33.0
    pip install --no-cache-dir --quiet --no-deps -r /opt/sweep/packages.txt
    pip install --no-cache-dir --quiet --no-deps --no-build-isolation /opt/sweep

%runscript
    exec sweep "$@"

%labels
    org.opencontainers.image.source https://github.com/Shashank-Yallamraju-Official/qec-sweep-aws-hpc
