Bootstrap: docker
From: python@sha256:8523d6abeb48ceae0b7240d30c5808fc26cb79c1a635bacdf19cf3baecfbec07

# The training image: the sweep image's base and pins plus torch's CPU build, for
# the train queue's x86 nodes. The project wheel is built outside the image, so no
# build backend and nothing unpinned ever enters it; the sweep image stays small,
# since every sweep node would otherwise carry torch for nothing.

%files
    image/train-packages.txt /opt/train/packages.txt
    dist/*.whl /opt/train/

%post
    # torch's CPU wheels live on PyTorch's own index; everything else is on PyPI.
    pip install --no-cache-dir --quiet --no-deps \
        --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple \
        -r /opt/train/packages.txt
    pip install --no-cache-dir --quiet --no-deps /opt/train/*.whl

%environment
    # The host's user site-packages and PYTHONPATH must not shadow the pinned ones.
    export PYTHONNOUSERSITE=1
    unset PYTHONPATH
    # PyMatching imports matplotlib, which wants a writable config dir the
    # container's home bind does not offer.
    export MPLCONFIGDIR=/tmp/matplotlib

%runscript
    exec decoder-train "$@"

%labels
    org.opencontainers.image.source https://github.com/Shashank-Yallamraju-Official/qec-sweep-aws-hpc
